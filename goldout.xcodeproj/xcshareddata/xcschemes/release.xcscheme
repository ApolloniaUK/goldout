<?xml version="1.0" encoding="UTF-8"?>
<Scheme
   LastUpgradeVersion = "1620"
   version = "2.2">
   <BuildAction
      parallelizeBuildables = "YES"
      buildImplicitDependencies = "YES"
      buildArchitectures = "All">
      <PostActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Run Script"
               scriptText = "# Copy the Release binaries into binaries/ after a successful build&#10;mkdir -p &quot;$PROJECT_DIR/binaries&quot;&#10;exec &gt; &quot;$PROJECT_DIR/binaries/copy.log&quot; 2&gt;&amp;1&#10;[ &quot;$CONFIGURATION&quot; = &quot;Release&quot; ] || exit 0&#10;&#10;for tool in goldout; do&#10;    if [ -f &quot;$BUILT_PRODUCTS_DIR/$tool&quot; ]; then&#10;        cp -p &quot;$BUILT_PRODUCTS_DIR/$tool&quot; &quot;$PROJECT_DIR/binaries/&quot;&#10;    fi&#10;done&#10;&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "F4510BE71FA3610A00A5C02C"
                     BuildableName = "goldout"
                     BlueprintName = "goldout"
                     ReferencedContainer = "container:goldout.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PostActions>
      <BuildActionEntries>
         <BuildActionEntry
            buildForTesting = "NO"
            buildForRunning = "YES"
            buildForProfiling = "NO"
            buildForArchiving = "NO"
            buildForAnalyzing = "NO">
            <BuildableReference
               BuildableIdentifier = "primary"
               BlueprintIdentifier = "F4510BE71FA3610A00A5C02C"
